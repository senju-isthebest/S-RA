# Environment configuration for Secrets Gradle Plugin.
# Gemini AI uses Firebase AI Logic with App Check (no API key required).

# Optional text-only Ollama fallback. Leave blank to use Gemini only.
# This is an endpoint/model setting, not a credential.
# Configure at build time via OLLAMA_BASE_URL environment variable or -POLLAMA_BASE_URL.
# Use a trusted host; never expose an unprotected Ollama endpoint publicly.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
# Optional image-capable Ollama model for OCR fallback. Leave blank to disable image fallback.
OLLAMA_VISION_MODEL=
