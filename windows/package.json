{
  "name": "sora-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SŌRA Desktop Companion for Windows (Electron + TypeScript)",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc && tsc -p tsconfig.renderer.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis msi"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
